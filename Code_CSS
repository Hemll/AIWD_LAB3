/* Page background */
body{
background-color:#f4f4f4;
font-family: Arial, sans-serif;
}

/* Heading styling */
h2{
color:#333;
margin-bottom:15px;
}

/* Paragraph spacing */
p{
font-size:16px;
line-height:1.6;
}

/* Image styling */
img{
border-radius:5px;
}

/* Button spacing */
button{
margin-right:10px;
}
